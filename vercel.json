{
  "rewrites": [
    {
      "source": "/u/:slug",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/u/:slug/checkin",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/u/:slug/keluarga",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/u/:slug/katering",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/u/:slug/album",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/privasi",
      "destination": "/privasi.html"
    },
    {
      "source": "/syarat",
      "destination": "/syarat.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/undangan.js": {
      "includeFiles": "index.html"
    }
  }
}
