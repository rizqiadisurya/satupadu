{
  "rewrites": [
    {
      "source": "/u/:slug",
      "destination": "/api/undangan?slug=:slug"
    },
    {
      "source": "/u/:slug/checkin",
      "destination": "/api/undangan?slug=:slug&sub=checkin"
    },
    {
      "source": "/u/:slug/keluarga",
      "destination": "/api/undangan?slug=:slug&sub=keluarga"
    },
    {
      "source": "/u/:slug/katering",
      "destination": "/api/undangan?slug=:slug&sub=katering"
    },
    {
      "source": "/u/:slug/album",
      "destination": "/api/undangan?slug=:slug&sub=album"
    },
    {
      "source": "/privasi",
      "destination": "/privasi.html"
    },
    {
      "source": "/syarat",
      "destination": "/syarat.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/music/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/undangan.js": {
      "includeFiles": "index.html"
    }
  },
  "regions": [
    "hnd1"
  ]
}
